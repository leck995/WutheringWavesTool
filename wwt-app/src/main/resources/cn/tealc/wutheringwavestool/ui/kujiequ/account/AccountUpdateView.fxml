<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.ToggleSwitch?>
<?import atlantafx.base.layout.InputGroup?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="account-dialog" stylesheets="@../../../css/kujiequ/Account.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.wutheringwavestool.ui.kujiequ.account.AccountUpdateView">
   <children>
      <Label fx:id="titleLabel" styleClass="title-3" />

      <HBox alignment="CENTER" spacing="0.0" styleClass="segmented">
         <children>
            <ToggleButton fx:id="smsTabBtn" mnemonicParsing="false" onAction="#switchToSms" styleClass="left-pill" text="验证码登录">
               <toggleGroup>
                  <ToggleGroup fx:id="tabToggleGroup" />
               </toggleGroup></ToggleButton>
            <ToggleButton fx:id="tokenTabBtn" mnemonicParsing="false" onAction="#switchToToken" styleClass="right-pill" text="Token登录" toggleGroup="$tabToggleGroup" />
         </children>
      </HBox>

      <StackPane fx:id="contentStack">
         <children>
            <!-- ========== Token 输入表单 ========== -->
            <VBox fx:id="addTab" alignment="TOP_CENTER" spacing="14.0" visible="false">
               <children>
                  <InputGroup alignment="CENTER">
                     <children>
                        <Label prefWidth="75.0" text="Token" />
                        <TextField fx:id="tokenField" maxWidth="225.0" prefWidth="200.0" promptText="输入库街区 Token" HBox.hgrow="ALWAYS" />
                     </children>
                  </InputGroup>
                  <InputGroup alignment="CENTER">
                     <children>
                        <Label prefWidth="75.0" text="Did" />
                        <TextField fx:id="didField" maxWidth="225.0" prefWidth="200.0" promptText="输入设备码 Did" HBox.hgrow="ALWAYS" />
                     </children>
                  </InputGroup>
                  <InputGroup alignment="CENTER">
                     <children>
                        <Label prefWidth="75.0" text="主账号" />
                        <ToggleSwitch fx:id="mainAccountCheckBox" labelPosition="RIGHT" maxWidth="225.0" prefWidth="225.0" text="设为主账号" translateX="35.0" />
                     </children>
                  </InputGroup>
                  <HBox alignment="CENTER" spacing="14.0" styleClass="form-actions">
                     <children>
                        <Button fx:id="okBtn" defaultButton="true" mnemonicParsing="false" onAction="#onSubmit" styleClass="accent" text="确定" />
                        <Button fx:id="cancelBtn" cancelButton="true" mnemonicParsing="false" onAction="#onCancel" text="取消" />
                     </children>
                  </HBox>
                  <VBox alignment="CENTER" spacing="4.0" styleClass="form-footer">
                     <children>
                        <HBox alignment="CENTER" spacing="12.0">
                           <children>
                              <Hyperlink onAction="#browserGuide" text="查看 Token 获取教程" />
                           </children>
                        </HBox>
                        <Label styleClass="form-hint" text="必须设置一个主账号；只支持移动端 Token" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </VBox>

            <!-- ========== 短信验证码表单 ========== -->
            <VBox fx:id="loginTab" spacing="14.0">
               <children>
                  <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="form-row" />
                  <InputGroup alignment="CENTER" layoutX="10.0" layoutY="75.0" prefWidth="400.0">
                     <children>
                        <Label styleClass="form-label" text="手机号" />
                        <TextField fx:id="loginPhoneFiled" prefWidth="202.0" promptText="输入 11 位手机号" />
                     </children>
                  </InputGroup>
                  <InputGroup alignment="CENTER" prefWidth="400.0">
                     <children>
                        <Label styleClass="form-label" text="验证码" />
                        <TextField fx:id="loginCodeField" prefWidth="150.0" promptText="输入验证码" />
                        <Button fx:id="getCodeBtn" mnemonicParsing="false" onAction="#sendLoginCode" styleClass="code-btn" text="获取" />
                     </children>
                  </InputGroup>
                  <InputGroup alignment="CENTER">
                     <children>
                        <Label styleClass="form-label" text="主账号" />
                        <ToggleSwitch fx:id="loginMainAccountCheckBox" alignment="TOP_LEFT" labelPosition="RIGHT" prefWidth="202.0" text="设为主账号" translateX="25.0" />
                     </children></InputGroup>
                  <HBox alignment="CENTER" spacing="14.0" styleClass="form-actions">
                     <children>
                        <Button fx:id="loginBtn" defaultButton="true" mnemonicParsing="false" onAction="#onLogin" styleClass="accent" text="登录" />
                        <Button cancelButton="true" mnemonicParsing="false" onAction="#onCancel" text="取消" />
                     </children>
                  </HBox>
                  <VBox alignment="CENTER" spacing="4.0" styleClass="form-footer">
                     <children>
                        <Label styleClass="form-hint" text="验证码登录会导致库街区 APP / 机器人退出登录，若多端登录且不会互顶，请使用 Token。" wrapText="true" />
                     </children>
                  </VBox>
               </children>
            </VBox>
         </children>
      </StackPane>
   </children>
   <padding>
      <Insets bottom="24.0" left="24.0" right="24.0" top="24.0" />
   </padding>
</VBox>
