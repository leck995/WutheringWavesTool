<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.Spacer?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<AnchorPane prefHeight="600.0" prefWidth="1000.0" styleClass="table-child" stylesheets="@../../css/gacha/CardPool.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.wutheringwavestool.ui.gacha.CardTableShowView">
    <children>
        <VBox fx:id="poolTypeBar" alignment="CENTER_LEFT" prefWidth="150.0" spacing="4.0" AnchorPane.bottomAnchor="150.0" AnchorPane.leftAnchor="5.0" AnchorPane.topAnchor="5.0">
            <padding>
                <Insets right="8.0" />
            </padding>
        </VBox>

        <TableView fx:id="cardTable" AnchorPane.bottomAnchor="45.0" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <columns>
                <TableColumn fx:id="nameCol" prefWidth="150.0" text="名称" />
                <TableColumn fx:id="qualityCol" prefWidth="80.0" text="星级" />
                <TableColumn fx:id="typeCol" prefWidth="80.0" text="类型" />
                <TableColumn fx:id="poolCol" prefWidth="120.0" text="卡池" />
                <TableColumn fx:id="timeCol" prefWidth="180.0" text="时间" />
            </columns>
            <placeholder>
                <Label fx:id="emptyLabel" text="无数据" />
            </placeholder>
         <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
         </columnResizePolicy>
        </TableView>

        <HBox alignment="CENTER_LEFT" spacing="8.0" AnchorPane.bottomAnchor="5.0" AnchorPane.leftAnchor="150.0" AnchorPane.rightAnchor="5.0">
            <Button fx:id="firstBtn" onAction="#onFirstPage">
                <graphic>
                    <FontIcon iconLiteral="mdal-first_page" />
                </graphic>
            <styleClass>
               <String fx:value="button-icon" />
               <String fx:value="flat" />
            </styleClass>
            </Button>
            <Button fx:id="prevBtn" onAction="#onPrevPage">
                <graphic>
                    <FontIcon iconLiteral="mdmz-navigate_before" />
                </graphic>
            <styleClass>
               <String fx:value="button-icon" />
               <String fx:value="flat" />
            </styleClass>
            </Button>
            <Label fx:id="pageInfoLabel" text="0 / 0" />
            <Button fx:id="nextBtn" onAction="#onNextPage">
                <graphic>
                    <FontIcon iconLiteral="mdmz-navigate_next" />
                </graphic>
            <styleClass>
               <String fx:value="button-icon" />
               <String fx:value="flat" />
            </styleClass>
            </Button>
            <Button fx:id="lastBtn" onAction="#onLastPage">
                <graphic>
                    <FontIcon iconLiteral="mdal-last_page" />
                </graphic>
            <styleClass>
               <String fx:value="button-icon" />
               <String fx:value="flat" />
            </styleClass>
            </Button>
            <Separator orientation="VERTICAL" />
            <Label text="每页:" />
            <ComboBox fx:id="pageSizeCombo" prefWidth="80.0" />
            <Label text="共" />
            <Label fx:id="totalCountLabel" text="0" />
            <Label text="条" />
            <Spacer />
            <Label fx:id="poolNameLabel" styleClass="text-subtle" />
        </HBox>
    </children>
</AnchorPane>
