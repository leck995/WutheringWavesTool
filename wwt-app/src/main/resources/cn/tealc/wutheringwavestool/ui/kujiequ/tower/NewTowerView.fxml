<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.Spacer?>
<?import java.lang.String?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="760.0" prefWidth="1100.0" stylesheets="@../../../css/kujiequ/tower/Tower.css"
           xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="cn.tealc.wutheringwavestool.ui.kujiequ.tower.NewTowerView">
    <styleClass>
        <String fx:value="tower" />
        <String fx:value="classic-tower" />
        <String fx:value="new-tower" />
    </styleClass>
    <children>
        <BorderPane fx:id="pagePane" styleClass="classic-tower-layout">
            <left>
                <VBox minWidth="216.0" prefWidth="224.0" maxWidth="224.0" spacing="10.0" styleClass="classic-sidebar-card">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <FontIcon iconLiteral="mdmz-map" iconSize="16" styleClass="sidebar-section-icon" />
                                <Label styleClass="classic-section-title" text="挑战模式" />
                            </children>
                        </HBox>
                        <ListView fx:id="difficuityListview" minHeight="118.0" prefHeight="128.0"
                                  styleClass="difficulty-list-view" />
                        <Separator />
                        <VBox spacing="7.0" styleClass="history-section" VBox.vgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <FontIcon iconLiteral="mdal-history" iconSize="16" styleClass="sidebar-section-icon" />
                                        <Label styleClass="classic-section-title" text="往期历史" />
                                    </children>
                                </HBox>
                                <ListView fx:id="towerHistoryListview" styleClass="difficulty-list-view" VBox.vgrow="ALWAYS" />
                            </children>
                        </VBox>
                    </children>
                    <padding>
                        <Insets bottom="15.0" left="12.0" right="12.0" top="15.0" />
                    </padding>
                </VBox>
            </left>
            <center>
                <VBox spacing="12.0" styleClass="classic-main">
                    <children>
                        <VBox spacing="12.0" styleClass="classic-results-panel" VBox.vgrow="ALWAYS">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="summary-bar">
                                    <children>
                                        <VBox spacing="2.0">
                                            <children>
                                                <Label fx:id="title" styleClass="classic-page-title" text="终焉矩阵" />
                                            </children>
                                        </VBox>
                                        <Separator orientation="VERTICAL" />
                                        <HBox alignment="CENTER_LEFT" spacing="18.0">
                                            <children>
                                                <VBox alignment="CENTER_LEFT" spacing="1.0">
                                                    <children>
                                                        <Label styleClass="metric-caption" text="累计积分" />
                                                        <Label fx:id="totalScoreLabel" styleClass="slash-score-value" text="0" />
                                                    </children>
                                                </VBox>
                                                <VBox alignment="CENTER_LEFT" spacing="1.0">
                                                    <children>
                                                        <Label styleClass="metric-caption" text="本期进度" />
                                                        <Label fx:id="progressLabel" styleClass="slash-score-value" text="第2轮  1/5" />
                                                    </children>
                                                </VBox>
                                                <Label fx:id="rankLabel" styleClass="summary-rank" text="S" />
                                            </children>
                                        </HBox>
                                        <Spacer />
                                        <HBox fx:id="endTimeBox" alignment="CENTER_LEFT" spacing="6.0" styleClass="end-time-box">
                                            <children>
                                                <FontIcon iconLiteral="mdmz-timer" iconSize="16" />
                                                <Label fx:id="seasonEndTimeLabel" styleClass="end-time" text="刷新时间" />
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                                <ScrollPane fx:id="contentScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="tower-scroll"
                                            VBox.vgrow="ALWAYS">
                                    <content>
                                        <TilePane fx:id="areaTilePane" alignment="TOP_LEFT" hgap="16.0" prefColumns="2"
                                                  prefTileWidth="420.0" tileAlignment="TOP_LEFT" vgap="16.0" />
                                    </content>
                                </ScrollPane>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </center>
            <padding>
                <Insets bottom="10.0" left="8.0" right="10.0" top="10.0" />
            </padding>
        </BorderPane>
    </children>
</StackPane>