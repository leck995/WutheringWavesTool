<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane prefHeight="600.0" prefWidth="1000.0" styleClass="game-update-view" stylesheets="@../../../css/game/manage/GameUpdate.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.wutheringwavestool.ui.game.manage.GameUpdateView">
   <children>
      <VBox prefWidth="900.0" spacing="14.0" alignment="TOP_CENTER">
         <children>
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Label styleClass="title-3" text="%ui.game_manager.update.title" />
                  <Separator orientation="VERTICAL" />
                  <Label fx:id="statusLabel" styleClass="text-subtle" text="就绪" />
               </children>
            </HBox>

            <!-- 版本信息 -->
            <VBox spacing="6.0" maxWidth="700.0">
               <children>
                  <HBox spacing="20.0">
                     <children>
                        <Label styleClass="title-4" text="%ui.game_manager.update.current" />
                        <Label fx:id="currentVersionLabel" styleClass="text-subtle" text="-" />
                     </children>
                  </HBox>
                  <HBox spacing="20.0">
                     <children>
                        <Label styleClass="title-4" text="%ui.game_manager.update.latest" />
                        <Label fx:id="latestVersionLabel" styleClass="text-subtle" text="-" />
                     </children>
                  </HBox>
                  <Label fx:id="stateLabel" styleClass="text-subtle" text="" />
               </children>
            </VBox>

            <!-- 进度 -->
            <VBox spacing="6.0" maxWidth="700.0">
               <children>
                  <ProgressBar fx:id="progressBar" maxWidth="700.0" progress="0.0" />
                  <Label fx:id="progressTextLabel" styleClass="text-subtle" text="0%" />
               </children>
            </VBox>

            <!-- 操作按钮 -->
            <HBox alignment="CENTER" spacing="8.0">
               <children>
                  <Button fx:id="checkBtn" mnemonicParsing="false" onAction="#checkUpdate" text="%ui.game_manager.update.check" />
                  <Button fx:id="updateBtn" mnemonicParsing="false" onAction="#update" text="%ui.game_manager.update.start" />
                  <Button fx:id="pauseBtn" mnemonicParsing="false" onAction="#pause" text="%ui.game_manager.download.pause" />
                  <Button fx:id="resumeBtn" mnemonicParsing="false" onAction="#resume" text="%ui.game_manager.download.resume" />
                  <Button fx:id="stopBtn" mnemonicParsing="false" onAction="#stop" text="%ui.game_manager.download.stop" />
               </children>
            </HBox>
         </children>
      </VBox>
   </children>
   <padding>
      <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
   </padding>
</StackPane>