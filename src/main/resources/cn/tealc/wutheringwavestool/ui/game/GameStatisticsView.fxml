<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>

<AnchorPane fx:id="root" prefHeight="800.0" prefWidth="1300.0" styleClass="game-statistics" stylesheets="@../../css/game/GameStatistics.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.wutheringwavestool.ui.game.GameStatisticsView">
   <children>
      <HBox fx:id="headerPane" layoutX="10.0" layoutY="10.0" prefHeight="35.0" spacing="20.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <Label styleClass="title-2" text="%ui.game_statistics.title" />
            <Separator orientation="VERTICAL" />
            <HBox>
               <children>
                  <ToggleButton contentDisplay="BOTTOM" mnemonicParsing="false" onAction="#toTime" selected="true" styleClass="child-select" text="%ui.game_statistics.nav.button03">
                     <graphic>
                        <Pane prefHeight="200.0" prefWidth="200.0" />
                     </graphic>
                     <toggleGroup>
                        <ToggleGroup fx:id="childSelectedToggle" />
                     </toggleGroup>
                  </ToggleButton>
                  <ToggleButton contentDisplay="BOTTOM" mnemonicParsing="false" onAction="#toRecord" styleClass="child-select" text="%ui.game_statistics.nav.button02" toggleGroup="$childSelectedToggle">
                     <graphic>
                        <Pane prefHeight="200.0" prefWidth="200.0" />
                     </graphic>
                  </ToggleButton>
               </children>
            </HBox>
         </children>
      </HBox>
      <StackPane fx:id="content" prefHeight="150.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="50.0" />
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</AnchorPane>
