<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.controls.Spacer?>
<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="700.0" prefWidth="1200.0" stylesheets="@../../css/cardpool/CardPool.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.wutheringwavestool.ui.gacha.CardAnalysisBaseView">
   <children>
  <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="180.0" prefWidth="200.0">
         <children>
            <HBox layoutX="1138.0" layoutY="10.0" spacing="20.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="10.0">
               <children>
                  <Label styleClass="title-2" text="%ui.analysis.title" />
                  <Separator orientation="VERTICAL" />
                  <HBox>
                     <children>
                        <ToggleButton contentDisplay="BOTTOM" mnemonicParsing="false" onAction="#toCommonChild" selected="true" styleClass="child-select" text="直观">
                           <toggleGroup>
                              <ToggleGroup fx:id="childSelectedToggle" />
                           </toggleGroup>
                           <graphic>
                              <Pane prefHeight="200.0" prefWidth="200.0" />
                           </graphic>
                        </ToggleButton>
                        <ToggleButton contentDisplay="BOTTOM" mnemonicParsing="false" onAction="#toDetailChild" styleClass="child-select" text="详情" toggleGroup="$childSelectedToggle">
                           <graphic>
                              <Pane prefHeight="200.0" prefWidth="200.0" />
                           </graphic>
                        </ToggleButton>
                     </children>
                  </HBox>
                  <Spacer layoutX="252.0" layoutY="10.0" />
                  <ComboBox fx:id="playerComboBox" prefWidth="150.0" />
                  <Button layoutX="394.0" layoutY="10.0" mnemonicParsing="false" onAction="#uploadGachaFile" text="%ui.analysis.upload">
                     <graphic>
                        <FontIcon iconLiteral="mdoal-insert_photo" />
                     </graphic>
                  </Button>
                  <Button layoutX="826.0" layoutY="10.0" mnemonicParsing="false" onAction="#snapshot" text="%ui.analysis.snapshot">
                     <graphic>
                        <FontIcon iconLiteral="mdoal-insert_photo" />
                     </graphic>
                  </Button>
                  <Button layoutX="180.0" layoutY="10.0" mnemonicParsing="false" onAction="#export" text="%ui.analysis.export">
                     <graphic>
                        <FontIcon iconLiteral="mdomz-save" />
                     </graphic></Button>
                  <Button layoutX="252.0" layoutY="10.0" mnemonicParsing="false" onAction="#delete" styleClass="danger" text="%ui.analysis.delete">
                     <graphic>
                        <FontIcon iconLiteral="mdral-delete_outline" />
                     </graphic></Button>
                  <Button layoutX="180.0" layoutY="10.0" mnemonicParsing="false" onAction="#fresh" styleClass="accent" text="%ui.analysis.account.refresh">
                     <graphic>
                        <FontIcon iconLiteral="mdmz-refresh" />
                     </graphic></Button>
                  <Button mnemonicParsing="false" onAction="#load" styleClass="success" text="%ui.analysis.account.get">
                     <graphic>
                        <FontIcon iconLiteral="mdoal-cloud" />
                     </graphic></Button>
               </children>
            </HBox>
            <Label styleClass="text-subtle" text="%ui.analysis.account.tip" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="50.0">
               <font>
                  <Font size="11.0" />
               </font></Label>
            <StackPane fx:id="content" prefHeight="150.0" prefWidth="200.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="80.0" />
         </children>
      </AnchorPane>
   </children>
   <styleClass>
      <String fx:value="background" />
      <String fx:value="card-pool" />
   </styleClass>
</StackPane>
