<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefWidth="450.0" spacing="10.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.wutheringwavestool.ui.system.home.SelectPlayerView">
   <children>
      <Label styleClass="title-2" text="选择账号" />
      <Label text="您可选择游戏内已登录账号" />
      <ListView fx:id="listview" prefHeight="200.0" prefWidth="200.0" />
      <HBox alignment="CENTER_RIGHT" spacing="10.0">
         <children>
            <Button fx:id="okBtn" mnemonicParsing="false" onAction="#onOk" text="确定" />
            <Button fx:id="cancelBtn" mnemonicParsing="false" onAction="#onCancel" text="取消" />
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</VBox>
