<?xml version="1.0" encoding="UTF-8"?>

<?import atlantafx.base.layout.InputGroup?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>


<VBox alignment="CENTER" prefHeight="700.0" prefWidth="1280.0" spacing="20.0" styleClass="app-account" stylesheets="@../../../css/system/Account.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.wutheringwavestool.ui.system.account.AppAccountView">
   <children>
      <Label styleClass="title-3" text="助手账号" />
      <InputGroup alignment="CENTER">
         <children>
            <Label prefWidth="120.0" text="用户名/订单号" />
            <TextField fx:id="usernameField" promptText="输入用户名/订单号" />
         </children>
      </InputGroup>
      <InputGroup alignment="CENTER">
         <children>
            <Label prefWidth="120.0" text="密码/订单号" />
            <PasswordField fx:id="passwordField" promptText="输入密码/订单号" />
         </children>
      </InputGroup>
      <HBox alignment="CENTER" prefWidth="200.0" spacing="20.0">
         <children>
            <Button fx:id="checkUserBtn" mnemonicParsing="false" onAction="#checkUserEvent" prefWidth="180.0" styleClass="accent" text="验证账号">
               <graphic>
                  <FontIcon iconLiteral="mdmz-refresh" />
               </graphic>
            </Button>
         </children>
      </HBox>
      <Label styleClass="text-muted" text="请赞助者将订单号按要求填写，完成验证即可使用&#10;如果订单号有问题或遗失，请联系开发者&#10;新订单号最迟在第二天更新，请耐心等待&#10;" textAlignment="CENTER" translateY="100.0" />
   </children>
</VBox>
