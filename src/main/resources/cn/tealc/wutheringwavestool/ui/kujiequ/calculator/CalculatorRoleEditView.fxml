<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import org.controlsfx.control.RangeSlider?>

<AnchorPane fx:id="root" prefHeight="600.0" prefWidth="1000.0" styleClass="role-edit" stylesheets="@../../../css/kujiequ/calculator/CalculatorRoleEdit.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.wutheringwavestool.ui.kujiequ.calculator.CalculatorRoleEditView">
   <children>
      <Label styleClass="title-2" text="计算" AnchorPane.leftAnchor="0.0" AnchorPane.topAnchor="0.0" />
      <HBox prefHeight="100.0" prefWidth="200.0" spacing="100.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="40.0">
         <children>
            <VBox alignment="TOP_CENTER" prefWidth="310.0" spacing="10.0">
               <children>
                  <HBox alignment="CENTER" spacing="10.0">
                     <children>
                        <ImageView fx:id="iconIV" fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true" />
                        <Label fx:id="roleNameLabel" styleClass="title-3" text="长离" />
                     </children>
                     <padding>
                        <Insets bottom="10.0" />
                     </padding>
                  </HBox>
                  <HBox styleClass="level-group">
                     <children>
                        <Label styleClass="skill-title" text="角色等级" />
                        <Label fx:id="levelLowLabel" styleClass="skill-level" text="LV.01" />
                        <RangeSlider fx:id="levelSlider" blockIncrement="1.0" highValue="90.0" lowValue="1.0" majorTickUnit="30.0" max="90.0" min="1.0" />
                        <Label fx:id="levelHighLabel" layoutX="10.0" layoutY="10.0" styleClass="skill-level" text="LV.90" />
                     </children>
                  </HBox>
                  <HBox layoutX="10.0" layoutY="138.0" styleClass="level-group">
                     <children>
                        <Label styleClass="skill-title" text="常态攻击" />
                        <Label fx:id="skillLowLabel01" styleClass="skill-level" text="LV.01" />
                        <RangeSlider fx:id="skillSlider01" blockIncrement="1.0" highValue="10.0" lowValue="1.0" majorTickUnit="1.0" max="10.0" min="1.0" />
                        <Label fx:id="skillHighLabel01" layoutX="10.0" layoutY="10.0" styleClass="skill-level" text="LV.10" />
                     </children>
                  </HBox>
                  <HBox layoutX="10.0" layoutY="158.0" styleClass="level-group">
                     <children>
                        <Label styleClass="skill-title" text="共鸣技能" />
                        <Label fx:id="skillLowLabel02" styleClass="skill-level" text="LV.01" />
                        <RangeSlider fx:id="skillSlider02" highValue="10.0" lowValue="1.0" majorTickUnit="5.0" max="10.0" min="1.0" />
                        <Label fx:id="skillHighLabel02" layoutX="10.0" layoutY="10.0" styleClass="skill-level" text="LV.10" />
                     </children>
                  </HBox>
                  <HBox layoutX="10.0" layoutY="218.0" styleClass="level-group">
                     <children>
                        <Label styleClass="skill-title" text="共鸣回路" />
                        <Label fx:id="skillLowLabel03" styleClass="skill-level" text="LV.01" />
                        <RangeSlider fx:id="skillSlider03" highValue="10.0" lowValue="1.0" majorTickUnit="5.0" max="10.0" min="1.0" />
                        <Label fx:id="skillHighLabel03" layoutX="10.0" layoutY="10.0" styleClass="skill-level" text="LV.10" />
                     </children>
                  </HBox>
                  <HBox layoutX="10.0" layoutY="178.0" styleClass="level-group">
                     <children>
                        <Label styleClass="skill-title" text="共鸣解放" />
                        <Label fx:id="skillLowLabel04" styleClass="skill-level" text="LV.01" />
                        <RangeSlider fx:id="skillSlider04" highValue="10.0" lowValue="1.0" majorTickUnit="5.0" max="10.0" min="1.0" />
                        <Label fx:id="skillHighLabel04" layoutX="10.0" layoutY="10.0" styleClass="skill-level" text="LV.10" />
                     </children>
                  </HBox>
                  <HBox layoutX="10.0" layoutY="198.0" styleClass="level-group">
                     <children>
                        <Label styleClass="skill-title" text="变奏技能" />
                        <Label fx:id="skillLowLabel05" styleClass="skill-level" text="LV.01" />
                        <RangeSlider fx:id="skillSlider05" blockIncrement="1.0" highValue="10.0" lowValue="1.0" majorTickUnit="5.0" max="10.0" min="1.0" />
                        <Label fx:id="skillHighLabel05" layoutX="10.0" layoutY="10.0" styleClass="skill-level" text="LV.10" />
                     </children>
                  </HBox>
                  <Label text="其他技能" />
