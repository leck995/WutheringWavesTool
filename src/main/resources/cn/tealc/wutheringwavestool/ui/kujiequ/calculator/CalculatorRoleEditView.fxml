                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                        <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                      <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
                    </rowConstraints>
                     <children>
                        <CheckBox fx:id="skillBreak01" accessibleText="2-1" mnemonicParsing="false" selected="true" text="常态-2" GridPane.halignment="CENTER" />
                        <CheckBox fx:id="skillBreak02" accessibleText="3-1" layoutX="10.0" layoutY="15.0" mnemonicParsing="false" selected="true" text="常态-3" GridPane.columnIndex="1" GridPane.halignment="CENTER" />
                        <CheckBox fx:id="skillBreak03" accessibleText="2-2" mnemonicParsing="false" selected="true" text="技能-2" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
                        <CheckBox fx:id="skillBreak04" accessibleText="3-2" mnemonicParsing="false" selected="true" text="技能-3" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="1" />
                        <CheckBox fx:id="skillBreak05" accessibleText="2-3" mnemonicParsing="false" selected="true" text="回路-2" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
                        <CheckBox fx:id="skillBreak06" accessibleText="3-3" mnemonicParsing="false" selected="true" text="回路-3" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="2" />
                        <CheckBox fx:id="skillBreak07" accessibleText="2-4" mnemonicParsing="false" selected="true" text="解放-2" GridPane.halignment="CENTER" GridPane.rowIndex="3" />
                        <CheckBox fx:id="skillBreak08" accessibleText="3-4" mnemonicParsing="false" selected="true" text="解放-3" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="3" />
                        <CheckBox fx:id="skillBreak09" accessibleText="2-5" mnemonicParsing="false" selected="true" text="变奏-2" GridPane.halignment="CENTER" GridPane.rowIndex="4" />
                        <CheckBox fx:id="skillBreak10" accessibleText="3-5" mnemonicParsing="false" selected="true" text="变奏-3" GridPane.columnIndex="1" GridPane.halignment="CENTER" GridPane.rowIndex="4" />
                     </children>
                  </GridPane>
                  <Label styleClass="text-subtle" text="角色等级低于技能要求等级时，即使技能等级拉高，也只会统计符合角色等级限制的技能材料。" wrapText="true" />
                  <HBox alignment="CENTER" spacing="20.0">
                     <children>
                        <Button mnemonicParsing="false" onAction="#calculate" styleClass="accent" text="查询" />
                        <Button mnemonicParsing="false" onAction="#reset" styleClass="danger" text="重置" />
                        <Button mnemonicParsing="false" onAction="#back" text="返回" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <VBox prefHeight="200.0" prefWidth="100.0" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="title-3" text="所需材料" />
                  <FlowPane fx:id="allItemFlowPane" hgap="10.0" prefHeight="200.0" prefWidth="200.0" vgap="10.0" VBox.vgrow="ALWAYS">
                     <VBox.margin>
                        <Insets />
                     </VBox.margin>
                  </FlowPane>
                  <Label layoutX="10.0" layoutY="10.0" styleClass="title-3" text="仍需材料">
                     <padding>
                        <Insets top="10.0" />
                     </padding></Label>
                  <FlowPane fx:id="lackItemFlowPane" hgap="10.0" layoutX="10.0" layoutY="29.0" prefHeight="200.0" prefWidth="200.0" vgap="10.0" VBox.vgrow="ALWAYS" />
                  <Label layoutX="10.0" layoutY="280.0" styleClass="title-4" text="背包可合成材料" />
                  <FlowPane fx:id="relateItemFlowPane" hgap="10.0" layoutX="10.0" layoutY="294.0" prefHeight="200.0" prefWidth="200.0" vgap="10.0" />
               </children></VBox>
         </children>
      </HBox>
   </children>
   <padding>
      <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
   </padding>
</AnchorPane>
