<BorderPane fx:id="root" prefHeight="648.0" prefWidth="1100.0" styleClass="home" stylesheets="@../css/Home.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="cn.tealc.wutheringwavestool.ui.HomeView">
   <right>
      <VBox alignment="TOP_RIGHT" prefHeight="200.0" prefWidth="100.0" spacing="8.0" styleClass="right" BorderPane.alignment="CENTER">
         <children>
            <VBox fx:id="rolePane" spacing="8.0" styleClass="role">
               <children>
                  <HBox fx:id="rolePane2" alignment="CENTER_LEFT" spacing="15.0" styleClass="role-data">
                     <children>
                        <ImageView fx:id="headIV" fitHeight="60.0" fitWidth="60.0" onMouseClicked="#changeHeaderImage" pickOnBounds="true" preserveRatio="true" styleClass="header">
                           <image>
                              <Image backgroundLoading="true" requestedHeight="60.0" requestedWidth="60.0" url="@../image/icon.png" />
                           </image>
                        </ImageView>
                        <VBox alignment="CENTER_LEFT" spacing="2.0" HBox.hgrow="ALWAYS">
                           <children>
                              <HBox>
                                 <children>
                                    <Label fx:id="roleNameLabel" styleClass="data-label-1" text="角色名" />
                                    <Spacer />
                                    <Button mnemonicParsing="false" onAction="#refreshRoleData">
                                       <graphic>
                                          <FontIcon iconLiteral="mdmz-refresh" />
                                       </graphic>
                                       <styleClass>
                                          <String fx:value="button-circle" />
                                          <String fx:value="refresh-btn" />
                                       </styleClass>
                                    </Button>
                                 </children>
                              </HBox>
                              <HBox alignment="CENTER_LEFT">
                                 <children>
                                    <Label fx:id="levelLabel" styleClass="level" text="LV.48" />
                                    <Spacer />
                                    <Label fx:id="gameLifeLabel" alignment="CENTER_RIGHT" styleClass="data-label-2" text="已游玩48天" />
                                 </children>
                              </HBox>
                           </children>
                        </VBox>
                     </children>
                  </HBox>
                  <Separator prefWidth="200.0" />
                  <GridPane minHeight="150.0" prefHeight="250.0" styleClass="daily-data">
                    <columnConstraints>
                      <ColumnConstraints hgrow="SOMETIMES" minWidth="10.0" prefWidth="100.0" />
